# 复制本文件为 .env.local 后填入你自己的 Key
# cp .env.example .env.local

# ===== 必填：AI 模型 =====
# 任何 OpenAI 兼容接口都可以。默认按 DeepSeek 配置。
AI_API_KEY=sk-your-deepseek-key

# ===== 选填：换模型 / 换服务商 =====
# 默认值：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_PROVIDER_NAME=deepseek

# 换成硅基流动（注册送额度，一个 key 用 Qwen / GLM / DeepSeek）：
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_PROVIDER_NAME=siliconflow

# 换成智谱 GLM-4-Flash（免费）：
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash
# AI_PROVIDER_NAME=zhipu

# 没配 Key 也能跑：题目走内置题库，点评走本地模拟文案。
